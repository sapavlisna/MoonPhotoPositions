<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="MoonApp.Maui.ViewPage"
             Title="Pohled ze stanoviště">
    <Grid RowDefinitions="*,Auto,Auto">
        <skia:SKCanvasView Grid.Row="0" x:Name="Canvas">
            <skia:SKCanvasView.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnPan" />
                <PinchGestureRecognizer PinchUpdated="OnPinch" />
            </skia:SKCanvasView.GestureRecognizers>
        </skia:SKCanvasView>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Padding="14,8">
            <Button Grid.Column="0" x:Name="PlayBtn" Text="▶" Style="{StaticResource Ghost}"
                    FontSize="16" WidthRequest="48" HeightRequest="44" Padding="0" Clicked="OnPlay" />
            <Slider Grid.Column="1" x:Name="TimeSlider" Minimum="0" Maximum="0"
                    ValueChanged="OnTimeChanged" VerticalOptions="Center" />
            <Label Grid.Column="2" x:Name="TimeLbl" FontFamily="monospace" FontSize="15"
                   VerticalOptions="Center" Text="--:--"
                   TextColor="{AppThemeBinding Light={StaticResource InkL}, Dark={StaticResource InkD}}" />
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="14,0,14,12">
            <Label Grid.Column="0" x:Name="InfoLbl" FontSize="11.5" VerticalOptions="Center"
                   LineBreakMode="TailTruncation"
                   TextColor="{AppThemeBinding Light={StaticResource MutedL}, Dark={StaticResource MutedD}}" />
            <Button Grid.Column="1" x:Name="AimBtn" Text="Na objekt" Style="{StaticResource Ghost}"
                    FontSize="13" HeightRequest="44" Padding="12,0" Clicked="OnAimObject" />
            <Button Grid.Column="2" Text="Zavřít" Style="{StaticResource Ghost}"
                    FontSize="13" HeightRequest="44" Padding="12,0" Clicked="OnClose" />
        </Grid>
    </Grid>
</ContentPage>
